# =============================================================================
# BABITO WhatsApp AI Agent — environment variables
# Copy to .env for local dev. In production set these in your host's secret
# manager (Railway/Fly/Render variables). NEVER commit real values.
# =============================================================================

NODE_ENV=development            # production enables strict checks (signature, admin password)
PORT=8080
LOG_LEVEL=info                  # debug | info | warn | error
LOG_MESSAGE_BODIES=false        # true only while debugging; bodies are in the DB anyway

# ---------------------------------------------------------------- Supabase DB
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the pooler "Session" string (port 5432) for this long-running server.
# This is a SERVER-ONLY credential. It never goes to a browser.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional: paste the Supabase CA certificate (PEM) to verify the server certificate.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5

# ------------------------------------------------------ WhatsApp Cloud API (Meta)
# Meta for Developers -> your app -> WhatsApp -> API Setup / App settings -> Basic
WHATSAPP_VERIFY_TOKEN=pick-a-long-random-string      # you invent it; paste the same in Meta's webhook config
WHATSAPP_APP_SECRET=                                 # App settings -> Basic -> App secret (webhook signatures)
WHATSAPP_ACCESS_TOKEN=                               # System-user permanent token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=                            # API Setup -> Phone number ID (NOT the phone number)
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TYPING_INDICATOR=true

# ------------------------------------------------------------ Shopify Admin API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com        # the .myshopify.com domain, not mybabito.com
SHOPIFY_API_VERSION=2026-07
# Option A: static Admin API token (legacy custom app, starts with shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Option B: Dev Dashboard app installed on your store (client-credentials grant; token auto-refreshes)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Required scopes (read-only is enough): read_products, read_orders, read_customers,
# read_fulfillments, read_legal_policies (+ read_all_orders for orders older than 60 days)
STORE_PUBLIC_URL=https://mybabito.com

# ------------------------------------------------------------------------- AI
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-opus-5            # customer-facing agent
AI_MODEL_MAIN_EFFORT=low               # low is usually enough for chat; raise if quality needs it
AI_MODEL_FAST=claude-haiku-4-5         # background summaries
AI_REFUSAL_FALLBACK=true               # server-side fallback model if the main model declines
AI_MAX_TOOL_ITERATIONS=6
AI_HISTORY_MESSAGES=16

# ------------------------------------------------------------------- Pipeline
DEBOUNCE_MS=2500                 # wait for a burst of short messages before answering
MAX_INBOUND_CHARS=2000
RATE_LIMIT_PER_10_MIN=25
HUMAN_MODE_TIMEOUT_HOURS=24      # AI resumes if staff were silent this long
SWEEPER_INTERVAL_MS=15000
MAX_PROCESS_ATTEMPTS=3

# ------------------------------------------------------ Staff notifications (optional)
STAFF_NOTIFY_WEBHOOK_URL=        # e.g. an n8n / Make / Slack incoming webhook
STAFF_WHATSAPP_NUMBERS=          # comma-separated, e.g. 972501111111 (only works inside Meta's 24h window)

# ------------------------------------------------------------------ Admin / cron
ADMIN_PASSWORD=                  # >= 12 chars; dashboard at /admin (user: admin)
CRON_SECRET=                     # for POST /cron/sweep and /cron/maintenance (Authorization: Bearer ...)
